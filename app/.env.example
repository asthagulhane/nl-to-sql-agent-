# Copy this file to app/.env locally. Never commit app/.env or real credentials.
GROQ_API_KEY=replace-with-your-groq-api-key

# API authentication: set at least one key. Role-specific keys take precedence.
# The generic key grants viewer access only.
QUERYMIND_API_KEY=replace-with-a-long-random-viewer-key
QUERYMIND_VIEWER_API_KEY=replace-with-a-long-random-viewer-key
QUERYMIND_ANALYST_API_KEY=replace-with-a-different-long-random-key
QUERYMIND_ADMIN_API_KEY=replace-with-another-long-random-key

# Optional service settings
QUERYMIND_RATE_LIMIT_PER_MINUTE=30
